# Copy to ~/.config/ragmcp/ragmcp.env and lock it down:  chmod 600 ~/.config/ragmcp/ragmcp.env
# systemd reads this file as plain KEY=VALUE lines (no quotes, no `export`).

# --- storage (Postgres listens on localhost only) ---
RAGMCP_STORE=postgres
RAGMCP_STORE_URL=postgresql://ragmcp:CHANGE_ME@localhost/ragmcp

# --- network: bind to the LAN IP (or 0.0.0.0) and pick a port ---
RAGMCP_HOST=192.168.1.20
RAGMCP_PORT=8000

# --- tokens: comma-separated, 24+ chars, long and random. Generate one with:
#       python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Give readers only reader tokens. Rotate by editing this file and restarting the service.
RAGMCP_ADMIN_TOKENS=CHANGE_ME_admin_token_at_least_24_chars
RAGMCP_READER_TOKENS=CHANGE_ME_reader_token_at_least_24_chars

# --- limits (defaults shown) ---
#RAGMCP_RATE_PER_MIN=60
#RAGMCP_RATE_BURST=20
#RAGMCP_MAX_UPLOAD_BYTES=10485760
#RAGMCP_MAX_DOC_CHARS=2000000

# --- search quality ---
#RAGMCP_RERANK=0            # 1 downloads and uses the cross-encoder on first use

# --- logging (stderr goes to the journal) ---
#RAGMCP_LOG_LEVEL=INFO
#RAGMCP_LOG_FILE=/home/YOU/.local/state/ragmcp/ragmcp.log

# --- backups (used by deploy/backup.sh) ---
#RAGMCP_BACKUP_DIR=/home/YOU/backups/ragmcp
#RAGMCP_BACKUP_KEEP_DAYS=14
